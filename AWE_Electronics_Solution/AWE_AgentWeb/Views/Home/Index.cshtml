@model List<AWE_DTO.Product>

@{
    ViewBag.Title = "Home Page";
}

<div class="row">
    <div class="col-md-12 text-right" style="margin-top: 20px;">
        <span class="text-success">Hi, <b>@ViewBag.UserName</b>!</span>
        <a href="/Account/Logout" class="btn btn-danger btn-sm" style="margin-left: 10px;">Logout</a>
    </div>
</div>
<hr />

<div class="jumbotron">
    <h1>AWE Electronics Store</h1>
    <p class="lead">Welcome to our online ordering platform, dear agent.</p>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>Latest Product List</h2>
        <hr />
    </div>

    @* Vòng lặp hiển thị từng sản phẩm *@
    @if (Model != null)
    {
        foreach (var item in Model)
        {
            <div class="col-md-4" style="margin-bottom: 30px;">
                <div class="card" style="border: 1px solid #ddd; padding: 15px; border-radius: 5px;">
                    <img src="https://via.placeholder.com/300x200" alt="@item.Name" style="width:100%; height: 200px; object-fit: cover;">

                    <h3 style="font-size: 18px; margin-top: 10px;">@item.Name</h3>
                    <p class="text-muted">Category: @item.CategoryName</p>

                    <h4 style="color: #d9534f;">@item.Price.ToString("N0") VNĐ</h4>

                    <p>Stock Quantity: <b>@item.StockQuantity</b></p>

                    <a href="#" class="btn btn-primary">Add to cart</a>
                    <a href="#" class="btn btn-default">Detail</a>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-danger">Can't load product detail'.</p>
    }
</div>