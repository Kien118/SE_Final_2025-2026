@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Đăng Nhập Đại Lý - AWE Electronics</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <style>
        body {
            background-color: #e9ecef; /* Màu nền xám nhẹ */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            background: #ffffff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .login-header h3 {
                color: #007bff; /* Màu xanh chủ đạo */
                font-weight: bold;
                margin-top: 10px;
            }

        .btn-custom {
            background-color: #007bff;
            color: white;
            font-weight: bold;
            padding: 10px;
            transition: 0.3s;
        }

            .btn-custom:hover {
                background-color: #0056b3;
                color: white;
            }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-header">
            <span class="glyphicon glyphicon-shopping-cart" style="font-size: 50px; color: #007bff;"></span>
            <h3>AWE AGENT LOGIN</h3>
            <p class="text-muted">Agent Ordering System</p>
        </div>

        <form action="/Account/Login" method="post">

            <div class="form-group">
                <label for="username"><span class="glyphicon glyphicon-user"></span>Username</label>
                <input type="text" class="form-control input-lg" id="username" name="username" placeholder="Enter Username" required autofocus>
            </div>

            <div class="form-group">
                <label for="password"><span class="glyphicon glyphicon-lock"></span> Password</label>
                <input type="password" class="form-control input-lg" id="password" name="password" placeholder="Enter password" required>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">
                    <span class="glyphicon glyphicon-exclamation-sign"></span> @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn btn-custom btn-block btn-lg">LOGIN</button>
        </form>

        <div class="text-center" style="margin-top: 20px;">
            <a href="#" class="text-muted">Forgot password?</a>
        </div>
    </div>

</body>
</html>